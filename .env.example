# --- LLM ---------------------------------------------------------------
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=            # required for LLM_PROVIDER=anthropic (never commit a real key)
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=300

# --- PostgreSQL (dedicated DEVELOPMENT database only) --------------------
# Matches docker-compose.yml. These are local-development placeholders, not real credentials.
DATABASE_URL=postgresql://agent:agent_dev_only@localhost:5432/database_agent
# Agent-owned schema that all generated objects live in (default: the project name from entities.json)
TARGET_SCHEMA=
STATEMENT_TIMEOUT_MS=30000

# --- Retry policy ---------------------------------------------------------
MAX_RETRIES=3                 # TOTAL attempts per stage (1 initial + corrections)
MAX_TEST_REPAIR_ROUNDS=2      # triage/repair rounds after failing BDD tests

# --- Output ---------------------------------------------------------------
GENERATED_DIR=generated
LOGS_DIR=logs
